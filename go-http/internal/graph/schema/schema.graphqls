# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Todo {
  id: ID!
  text: String!
  done: Boolean!
  user: User!
}

type User {
  id: ID!
  name: String!
}

type Query {
  todos: [Todo!]!
}

input NewTodo {
  text: String!
  userId: String!
}

type Mock {
  id: ID!
  done: Boolean!
  mockDelay: String!
}

input NewMock {
  mockDelay: String!
}

type Mutation {
  createTodo(input: NewTodo!): Todo!
  createMock(input: NewMock!): Mock!
}
